  "components": {
    "schemas": {
      "DriverInput": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "DriverInput"
      },
      "DriverOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "vehicle_assignments": {
            "items": {
              "$ref": "#/components/schemas/VehicleAssignment"
            },
            "type": "array",
            "title": "Vehicle Assignments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "active",
          "full_name",
          "phone",
          "is_active",
          "vehicle_assignments"
        ],
        "title": "DriverOut"
      },
      "DriverProfileOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "active"
        ],
        "title": "DriverProfileOut"
      },
      "GpsGap": {
        "properties": {
          "from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "From"
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "To"
          },
          "reason": {
            "type": "string",
            "const": "MISSING_OR_INVALID_GPS",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "from",
          "to",
          "reason"
        ],
        "title": "GpsGap"
      },
      "GpsHistory": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/GpsPosition"
            },
            "type": "array",
            "title": "Points"
          },
          "segments": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/GpsPosition"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Segments"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GpsGap"
            },
            "type": "array",
            "title": "Gaps"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/GpsStop"
            },
            "type": "array",
            "title": "Stops"
          }
        },
        "type": "object",
        "required": [
          "points",
          "segments",
          "gaps",
          "stops"
        ],
        "title": "GpsHistory"
      },
      "GpsPosition": {
        "properties": {
          "position_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position Id"
          },
          "traccar_device_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traccar Device Id"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "speed_kmh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed Kmh"
          },
          "course": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Course"
          },
          "gps_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gps At"
          },
          "server_received_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Received At"
          },
          "backend_received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Backend Received At"
          },
          "acc": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acc"
          },
          "engine_state": {
            "type": "string",
            "enum": [
              "MOVING",
              "IDLING",
              "PARKED",
              "UNKNOWN"
            ],
            "title": "Engine State"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid"
