{
  "name": "fleet-delivery",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/admin-web",
    "apps/driver-mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @fleet/admin-web",
    "dev:mobile": "npm run start --workspace @fleet/driver-mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/shared/tests/*.test.mjs",
    "build:web": "npm run build --workspace @fleet/admin-web",
    "build:mobile": "npm run export --workspace @fleet/driver-mobile"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "12.2.x"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "packageManager": "npm@12.2.0"
}
