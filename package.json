{
  "name": "fleet-delivery", "version": "0.0.0", "private": true,
  "workspaces": ["apps/admin-web", "apps/driver-mobile", "packages/shared"],
  "scripts": {
    "dev:web": "npm run dev --workspace @fleet/admin-web",
    "dev:mobile": "npm run start --workspace @fleet/driver-mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test packages/shared/tests/*.test.mjs",
    "build:web": "npm run build --workspace @fleet/admin-web",
    "build:mobile": "npm run export --workspace @fleet/driver-mobile"
  },
  "engines": {"node": ">=22.13.0"}
}
